        <http_method>GET</http_method>
        <name>Get Vehicle</name>
        <operation_script><![CDATA[(function process(request, response) {
    var vin = request.pathParams.vin;
    
    var gr = new GlideRecord('x_snc_vehicles_api_vehicle');
    if (gr.get('vin', vin)) {
        return {
            make: gr.getValue('make'),
            model: gr.getValue('model'),
            vin: gr.getValue('vin'),
            year: gr.getValue('year')
        };
    }
    
    response.setStatus(404);
    return { error: 'Vehicle not found' };
})(request, response);]]></operation_script>
        <operation_uri>/api/x_snc_vehicles_api/vehicles_api/vehicle/{vin}</operation_uri>
