        <http_method>POST</http_method>
        <name>Create Vehicles</name>
        <operation_script><![CDATA[(function process(request, response) {
    var body = request.body.data;
    var created = [];
    
    for (var i = 0; i < body.vehicles.length; i++) {
        var v = body.vehicles[i];
        
        var gr = new GlideRecord('x_snc_vehicles_api_vehicle');
        gr.initialize();
        gr.setValue('make', v.make);
        gr.setValue('model', v.model);
        gr.setValue('vin', v.vin);
        gr.setValue('year', v.year);
        gr.setValue('country', v.country);
        gr.setValue('city', v.city);
        var sysId = gr.insert();
        
        created.push({ vin: v.vin, sys_id: sysId });
    }
    
    response.setStatus(201);
    return { created: created };
})(request, response);]]></operation_script>
