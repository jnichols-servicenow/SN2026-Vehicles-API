        <default_operation_uri>/api/x_snc_vehicles_api/vehicles_api/vehicle/{vin}</default_operation_uri>
        <enforce_acl>84b7299997e20350126958900153af99</enforce_acl>
        <http_method>PUT</http_method>
        <name>Update Vehicle (v2)</name>
        <operation_script><![CDATA[(function process(request, response) {
    var vin = request.pathParams.vin;
    var body = request.body.data;
    
    var gr = new GlideRecordSecure('x_snc_vehicles_api_vehicle');
    if (!gr.get('vin', vin)) {
        response.setStatus(404);
        return { error: 'Vehicle not found' };
    }
    
    if (body.make !== undefined) gr.setValue('make', body.make);
    if (body.model !== undefined) gr.setValue('model', body.model);
    if (body.year !== undefined) gr.setValue('year', body.year);
    if (body.country !== undefined) gr.setValue('country', body.country);
    if (body.city !== undefined) gr.setValue('city', body.city);
    gr.update();
    
    return { sys_id: gr.getUniqueValue(), vin: vin };
})(request, response);]]></operation_script>
